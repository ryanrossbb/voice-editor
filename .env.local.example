# Anthropic — for the voice revision step
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# WordPress — for the drafts dashboard
# Generate an Application Password under:
#   WordPress admin -> Users -> Profile -> Application Passwords
WP_SITE_URL=https://yoursite.com
WP_USERNAME=your-wp-username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Supabase — for the login wall (optional but strongly recommended for production)
# Get these from your Supabase project: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Google Sheet — for the "Coming Up" pipeline panel (optional)
# Publish your sheet to web as CSV (File -> Share -> Publish to web -> CSV)
# Then paste the resulting URL here.
GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/xxxx/pub?output=csv
